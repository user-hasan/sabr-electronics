# ==============================================================================
# صَبْر إلكترونكس — نموذج متغيرات البيئة والأسرار
# Sabr Electronics — Environment Configuration Template (.env.example)
# ==============================================================================
# ملاحظة هامة: هذا الملف عبارة عن نموذج توضيحي فقط يحتوي على مسميات الإعدادات.
# لا تضع أي مفاتيح سرية حقيقية أو كلمات مرور داخل هذا الملف أو داخل Git.
# ==============================================================================

# البيئة العامة للتطبيق (development, staging, production)
APP_ENV=development

# اسم المركز التجاري الافتراضي
SHOP_NAME="صبر إلكترونكس"
SHOP_PHONE="777000000"
DEFAULT_CURRENCY="YER"

# مفتاح Gemini API السحابي للخدمات المتقدمة (v2 - اختياري)
# احصل على المفتاح من Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# إعدادات التحديثات الهوائية OTA (v2)
GITHUB_REPO_OWNER="user-hasan"
GITHUB_REPO_NAME="sabr_electronics"
